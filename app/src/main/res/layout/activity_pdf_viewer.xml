<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#191C1E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header Action Bar (Matching Screenshot 1) -->
        <LinearLayout
            android:id="@+id/layoutTopBarContainer"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="#191C1E"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <!-- Back Button (White Circle) -->
            <FrameLayout
                android:id="@+id/btnTopBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_white"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="Back"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="#000000" />
            </FrameLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- W (Word) Action Button (White Circle) -->
            <FrameLayout
                android:id="@+id/btnTopWord"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_circle_white"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="W"
                    android:textColor="#000000"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Rotate Action Button (White Circle) -->
            <FrameLayout
                android:id="@+id/btnTopRotate"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_circle_white"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="Rotate"
                    android:src="@drawable/ic_top_rotate"
                    app:tint="#000000" />
            </FrameLayout>

            <!-- Info Action Button (White Circle) -->
            <FrameLayout
                android:id="@+id/btnTopInfo"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_circle_white"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="Details"
                    android:src="@drawable/ic_info"
                    app:tint="#000000" />
            </FrameLayout>

            <!-- Share Action Button (White Circle) -->
            <FrameLayout
                android:id="@+id/btnTopShare"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_circle_white"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="Share"
                    android:src="@drawable/ic_top_share"
                    app:tint="#000000" />
            </FrameLayout>

            <!-- Menu Action Button (White Circle) -->
            <FrameLayout
                android:id="@+id/btnTopMenu"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_circle_white"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="More options"
                    android:src="@drawable/ic_more_vert"
                    app:tint="#000000" />
            </FrameLayout>

        </LinearLayout>

        <!-- In-Document Search Bar (Hidden by default) -->
        <LinearLayout
            android:id="@+id/layoutSearchBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#1F2023"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnCloseSearch"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close search"
                android:src="@drawable/ic_arrow_back"
                app:tint="#E3E2E6" />

            <EditText
                android:id="@+id/etSearchQuery"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_drive_search_bar"
                android:hint="@string/search"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:textColor="#E3E2E6"
                android:textColorHint="#8E918F"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvSearchMatchCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:text="0/0"
                android:textColor="#C4C6D0"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnSearchPrev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Previous match"
                android:src="@drawable/ic_chevron_left"
                app:tint="#E3E2E6" />

            <ImageButton
                android:id="@+id/btnSearchNext"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Next match"
                android:src="@drawable/ic_chevron_right"
                app:tint="#E3E2E6" />

        </LinearLayout>

        <!-- PDF Pages RecyclerView Canvas -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPdfPages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingVertical="4dp" />

    </LinearLayout>

    <!-- Floating Scroll Stick Pill (Right Edge - Matching Screenshot 2) -->
    <LinearLayout
        android:id="@+id/layoutVerticalScrollPill"
        android:layout_width="44dp"
        android:layout_height="72dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_vertical_scroll_pill"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Scroll up"
            android:src="@drawable/ic_arrow_up_small"
            app:tint="#FFFFFF" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="4dp"
            android:contentDescription="Scroll down"
            android:src="@drawable/ic_arrow_down_small"
            app:tint="#FFFFFF" />

    </LinearLayout>

    <!-- Bottom Left Page Counter Badge Pill (Matching Screenshot 2) -->
    <LinearLayout
        android:id="@+id/layoutPageCounterPill"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_bottom_page_counter_pill"
        android:elevation="6dp"
        android:gravity="center"
        android:paddingHorizontal="14dp">

        <TextView
            android:id="@+id/tvPageBadgeCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1/1"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Bottom Right Floating Pencil FAB (Matching Screenshot 2) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabEditDocument"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:contentDescription="Edit document"
        android:src="@drawable/ic_pencil"
        app:backgroundTint="#FF3B30"
        app:fabSize="normal"
        app:tint="#FFFFFF" />

    <!-- Google Drive Control Pill Bar (Hidden by default, used for zoom/grid) -->
    <LinearLayout
        android:id="@+id/cardBottomControls"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_drive_floating_bar"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnBottomGrid"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Grid view"
            android:src="@drawable/ic_grid_view"
            app:tint="#E3E2E6" />

        <ImageButton
            android:id="@+id/btnPrevPage"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Previous Page"
            android:src="@drawable/ic_chevron_left"
            app:tint="#E3E2E6" />

        <TextView
            android:id="@+id/tvReaderPageIndicator"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/bg_drive_page_pill"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="1 / 1"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnNextPage"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Next Page"
            android:src="@drawable/ic_chevron_right"
            app:tint="#E3E2E6" />

        <ImageButton
            android:id="@+id/btnZoomOut"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Zoom Out"
            android:src="@drawable/ic_zoom_out"
            app:tint="#E3E2E6" />

        <ImageButton
            android:id="@+id/btnZoomIn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Zoom In"
            android:src="@drawable/ic_zoom_in"
            app:tint="#A8C7FA" />

    </LinearLayout>

    <!-- Draw & Edit Markup Toolbar Overlay -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardEditControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:visibility="gone"
        app:cardBackgroundColor="#282A2D"
        app:cardCornerRadius="0dp"
        app:cardElevation="12dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp">

            <HorizontalScrollView
                android:id="@+id/scrollEditTools"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnToolPen"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Pen Tool"
                        android:src="@android:drawable/ic_menu_edit"
                        app:tint="#A8C7FA" />

                    <ImageButton
                        android:id="@+id/btnToolHighlighter"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Highlighter"
                        android:src="@android:drawable/ic_menu_view"
                        app:tint="#E3E2E6" />

                    <ImageButton
                        android:id="@+id/btnToolEraser"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Eraser"
                        android:src="@drawable/ic_close"
                        app:tint="#E3E2E6" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:layout_marginHorizontal="8dp"
                        android:background="#3C4043" />

                    <View
                        android:id="@+id/btnColorRed"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="#E53935" />

                    <View
                        android:id="@+id/btnColorBlue"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="8dp"
                        android:background="#1E88E5" />

                    <View
                        android:id="@+id/btnColorBlack"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="8dp"
                        android:background="#000000" />

                    <View
                        android:id="@+id/btnColorGreen"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="8dp"
                        android:background="#43A047" />

                    <View
                        android:id="@+id/btnColorYellow"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="8dp"
                        android:background="#FFEB3B" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:layout_marginHorizontal="8dp"
                        android:background="#3C4043" />

                    <ImageButton
                        android:id="@+id/btnUndoDraw"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Undo stroke"
                        android:src="@android:drawable/ic_menu_revert"
                        app:tint="#E3E2E6" />

                    <ImageButton
                        android:id="@+id/btnRedoDraw"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Redo stroke"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#E3E2E6" />

                    <ImageButton
                        android:id="@+id/btnClearDraw"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Clear drawings"
                        android:src="@android:drawable/ic_menu_delete"
                        app:tint="#E3E2E6" />

                </LinearLayout>

            </HorizontalScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="6dp"
                android:background="#3C4043" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/menu_draw_edit"
                    android:textColor="#C4C6D0"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelEditMode"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="@string/close"
                    android:textColor="#E3E2E6"
                    android:textSize="12sp"
                    app:cornerRadius="8dp"
                    app:strokeColor="#5B5E62" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDoneEditMode"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:text="@string/save"
                    android:textColor="#00315B"
                    android:textSize="12sp"
                    app:backgroundTint="#A8C7FA"
                    app:cornerRadius="8dp" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Zoom Toast Readout -->
    <TextView
        android:id="@+id/tvZoomToast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_rounded_toast"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
