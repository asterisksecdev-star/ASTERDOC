<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_light"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/doc_library"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Files toolbar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFilesSelectAll"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Select all"
                    android:textAllCaps="false"
                    android:textColor="@color/primary"
                    app:cornerRadius="10dp"
                    app:strokeColor="@color/primary" />

                <ImageButton
                    android:id="@+id/btnFilesSort"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Sort files"
                    android:src="@android:drawable/ic_menu_sort_by_size"
                    app:tint="@color/primary" />

                <ImageButton
                    android:id="@+id/btnFilesSearch"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Search files"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="@color/primary" />

            </LinearLayout>

            <!-- Search bar -->
            <LinearLayout
                android:id="@+id/layoutFilesSearchBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etFilesSearchQuery"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_field"
                    android:hint="Search documents..."
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:paddingHorizontal="12dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary" />

                <ImageButton
                    android:id="@+id/btnFilesCloseSearch"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Close search"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="@color/text_secondary" />

            </LinearLayout>

            <!-- Document tabs -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayoutFiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:tabIndicatorColor="@color/primary"
                app:tabMode="scrollable"
                app:tabSelectedTextColor="@color/primary"
                app:tabTextColor="@color/text_secondary" />

            <!-- Bulk actions -->
            <include
                android:id="@+id/llBulkActions"
                layout="@layout/layout_bulk_action_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <!-- Trash actions -->
            <LinearLayout
                android:id="@+id/llTrashActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEmptyTrash"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="@string/empty_trash"
                    app:backgroundTint="#EA4335"
                    app:cornerRadius="10dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- File list and empty state -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFilesList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="88dp" />

            <TextView
                android:id="@+id/tvEmptyFiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="32dp"
                android:text="@string/no_files_found_in_section"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

    <!-- Import document -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabOpenPhoneDocFiles"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:text="@string/open"
        android:textColor="@color/white"
        app:backgroundTint="@color/primary"
        app:icon="@android:drawable/ic_input_add"
        app:iconTint="@color/white" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
