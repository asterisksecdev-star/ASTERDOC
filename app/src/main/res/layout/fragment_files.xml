<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_light"
        android:elevation="2dp"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/doc_library"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />



        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayoutFiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:tabIndicatorColor="@color/primary"
            app:tabMode="scrollable"
            app:tabSelectedTextColor="@color/primary"
            app:tabTextColor="@color/text_secondary" />

        <include
            android:id="@+id/llBulkActions"
            layout="@layout/layout_bulk_action_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/llTrashActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEmptyTrash"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/empty_trash"
                app:backgroundTint="#EA4335"
                app:cornerRadius="10dp" />

        </LinearLayout>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFilesList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingVertical="8dp" />

    <TextView
        android:id="@+id/tvEmptyFiles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="32dp"
        android:text="@string/no_files_found_in_section"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:visibility="gone" />

</LinearLayout>