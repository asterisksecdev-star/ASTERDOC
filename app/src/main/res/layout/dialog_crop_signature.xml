<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1C1E24"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Crop Signature Image ✂"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Live Dimension Indicator -->
    <TextView
        android:id="@+id/tvCropDimensions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Original: 0 × 0 px  ➔  Crop: 0 × 0 px"
        android:textColor="#0D6EFD"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Side-by-Side Live Previews (Original vs Live Cropped Result) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <!-- Original Image View -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#121316"
            android:padding="8dp">

            <ImageView
                android:id="@+id/ivCropImagePreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Original Signature"
                android:scaleType="fitCenter" />

        </FrameLayout>

        <View
            android:layout_width="8dp"
            android:layout_height="match_parent" />

        <!-- Live Cropped Result Preview View -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#121316"
            android:padding="8dp">

            <ImageView
                android:id="@+id/ivCropResultPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Live Cropped Result"
                android:scaleType="fitCenter" />

        </FrameLayout>

    </LinearLayout>

    <!-- Crop Margins Sliders Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical">

        <!-- Top Trim -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:text="Top Trim:"
                android:textColor="#A0A4AB"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/seekBarCropTop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="40"
                android:progress="0" />

        </LinearLayout>

        <!-- Bottom Trim -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:text="Bottom:"
                android:textColor="#A0A4AB"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/seekBarCropBottom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="40"
                android:progress="0" />

        </LinearLayout>

        <!-- Left Trim -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:text="Left Trim:"
                android:textColor="#A0A4AB"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/seekBarCropLeft"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="40"
                android:progress="0" />

        </LinearLayout>

        <!-- Right Trim -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:text="Right Trim:"
                android:textColor="#A0A4AB"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/seekBarCropRight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="40"
                android:progress="0" />

        </LinearLayout>

    </LinearLayout>

    <!-- Dialog Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetCrop"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="↺ Reset"
            android:textColor="#0D6EFD"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            app:strokeColor="#0D6EFD"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelCrop"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:text="Cancel"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            app:strokeColor="#4E515B"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApplyCrop"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:text="Apply Crop ✓"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="#0D6EFD"
            app:cornerRadius="10dp" />

    </LinearLayout>

</LinearLayout>
